{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "NSAppleEventsUsageDescription": {
      "comment": "Automation permission for explicitly requested Finder folder access, terminal creation and scripts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arc Kit accesses other apps when you save a clipboard item to the current Finder folder, create terminal windows or tabs, or run a script you choose."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arc Kit 仅在你将剪贴板内容存到当前 Finder 文件夹、新建终端窗口或标签、运行自选脚本时访问相应应用。"
          }
        }
      }
    }
  }
}
