    "about.sparkleUpdates": {
      "extractionState": "manual",
      "comment": "About settings: Sparkle software updates.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically checks for new releases. Downloads are verified before you choose to install and restart."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动检查新版本，下载后校验更新包，由你选择安装并重新启动。"
          }
        }
      }
    },
    "about.updatesUnavailable": {
      "extractionState": "manual",
      "comment": "About settings: Sparkle software updates.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Software updates are available in the installed app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "软件更新仅在完整应用中可用。"
          }
        }
      }
    },
    "about.automaticUpdates": {
      "extractionState": "manual",
      "comment": "About settings: Sparkle software updates.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically check for updates"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动检查更新"
          }
        }
      }
    },
    "about.lastUpdateCheck": {
      "extractionState": "manual",
      "comment": "About settings: Sparkle software updates.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last checked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次检查"
          }
        }
      }
    },
    "about.unsignedDistribution": {
      "extractionState": "manual",
      "comment": "About settings: Sparkle software updates.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build is produced by GitHub Actions without Apple Developer ID signing or notarization. Update archives are verified with Ed25519 signatures."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本版本由 GitHub Actions 构建，未使用 Apple Developer ID 签名或公证；更新包通过 Ed25519 签名校验。"
          }
        }
      }
    },
    "about.automaticDownloads": {
      "extractionState": "manual",
      "comment": "Optional Sparkle automatic download and install-on-quit setting.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically download and install updates on quit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动下载并在退出时安装更新"
          }
        }
      }
    }
  },
  "version": "1.0"
}
