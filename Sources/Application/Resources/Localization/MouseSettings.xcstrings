    "gestures.restores.gesture.enablement.distance.hints.all": {
      "extractionState": "manual",
      "comment": "Used in MouseGestureEditor.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restores gesture enablement, distance, hints and all four direction actions. Scrolling feel and per-app settings are unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手势开关、触发距离、提示和四个方向动作会恢复推荐值；滚动手感和按 App 设置不受影响。"
          }
        }
      }
    },
