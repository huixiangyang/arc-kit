    "modifier.now.controls.previous.set": {
      "extractionState": "manual",
      "comment": "Used in MouseEditorControls. Arguments: 1 (String), 2 (String), 3 (String).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ now controls “%2$@”. The previous %3$@ is set to “None” to prevent one key from triggering multiple actions."
