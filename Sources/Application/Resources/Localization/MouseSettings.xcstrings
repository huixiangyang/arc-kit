    "scroll.base.distance.standard.notched.wheel": {
      "extractionState": "manual",
      "comment": "Used in MouseScrollingEditor.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Base distance for a standard notched wheel. High-resolution input uses its original distance. Usually, adjusting scroll speed above is enough."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "普通刻度滚轮的基础距离；高分辨率输入按原始距离处理。通常只需调整上方滚动速度。"
          }
        }
      }
    },
