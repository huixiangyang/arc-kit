    "scenes.undoHint": {
      "extractionState": "manual",
      "comment": "Window scene settings and execution feedback.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo restores only windows moved by this operation that still exist. It does not reopen closed windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销仅恢复本次移动且仍然存在的窗口，不会重新打开已关闭的窗口。"
          }
        }
      }
    },
