    "scenes.matchHint": {
      "extractionState": "manual",
      "comment": "Window scene settings and execution feedback.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After an app restarts, only a unique match is used. Ambiguous windows require manual rebinding. Editing this rule clears the current window binding."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用重启后仅使用唯一匹配的窗口；多个候选需手动重新绑定。修改规则会清除当前窗口绑定。"
          }
        }
      }
    },
    "scenes.rebind": {
      "extractionState": "manual",
      "comment": "Window scene settings and execution feedback.",
