{
  "sourceLanguage": "en",
  "strings": {
    "backup.another.settings.backup.restore": {
      "extractionState": "manual",
      "comment": "Used in SettingsBackupService.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another settings backup or restore is in progress. Wait for it to finish."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一项设置备份或恢复操作仍在进行，请完成后再试"
          }
        }
      }
    },
    "backup.appVersionRequired": {
      "extractionState": "manual",
      "comment": "Used in SettingsBackupService.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App version cannot be empty"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用版本不能为空"
          }
        }
      }
    },
    "backup.backup.damaged.modified": {
      "extractionState": "manual",
      "comment": "Used in SettingsBackupService. Arguments: 1 (String).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup is damaged or modified: %1$@"
