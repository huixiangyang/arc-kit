    "data.clears.rebuildable.caches.assets.configuration": {
      "extractionState": "manual",
      "comment": "Used in DataManagementView.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears only rebuildable caches. Assets, configuration and backups are preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只清理可重建的缓存，保留素材、配置和备份。"
          }
        }
      }
    },
    "data.created.automatically.importing.settings.restoring": {
      "extractionState": "manual",
      "comment": "Used in DataManagementView.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Created automatically before importing settings or restoring defaults. Includes general, Finder, window and mouse settings, plus templates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入设置或恢复默认前自动创建，只包含通用、Finder、窗口、鼠标设置与模板。"
          }
        }
      }
    },
    "data.current.settings.become.new.restore.point": {
      "extractionState": "manual",
      "comment": "Used in DataManagementView.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current settings become the new restore point before settings and templates are restored. Wallpapers and app backgrounds are preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前设置会先成为新的恢复点，再恢复备份中的设置与模板。壁纸和应用背景保留。"
          }
        }
      }
    },
    "data.data.folder": {
