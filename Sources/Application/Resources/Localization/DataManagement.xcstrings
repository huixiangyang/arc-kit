    "backup.concurrentChange": {
      "extractionState": "manual",
      "comment": "Used in SettingsBackupService.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings changed during this operation. Replacement cancelled to preserve your changes; retry the operation."
