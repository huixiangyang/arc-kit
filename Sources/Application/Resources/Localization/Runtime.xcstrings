{
  "sourceLanguage": "en",
  "strings": {
    "connection.background.jobs.remain.shutdown.incomplete": {
      "extractionState": "manual",
      "comment": "Used in RuntimeHostCoordinator.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background jobs remain; shutdown is incomplete"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台作业仍存在，尚未完成退出"
          }
        }
      }
    },
    "connection.background.session.notReady": {
      "extractionState": "manual",
      "comment": "Used in RuntimeHostCoordinator.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background session not ready"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台会话尚未就绪"
          }
        }
      }
    },
    "connection.background.session.notReady.retry.later": {
      "extractionState": "manual",
      "comment": "Used in RuntimeHostCoordinator.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background session not ready. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台会话尚未就绪，请稍后重试"
          }
        }
      }
    },
    "connection.background.stopping": {
      "extractionState": "manual",
      "comment": "Used in RuntimeHostCoordinator.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background stopping"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台正在停止"
          }
        }
      }
    },
    "connection.disconnected": {
      "extractionState": "manual",
      "comment": "Used in RuntimeHostCoordinator.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background disconnected. Check background permission and installation status first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台尚未连接，请先重新检测后台许可与安装状态"
          }
        }
      }
    },
    "connection.interrupted": {
      "extractionState": "manual",
      "comment": "Used in RuntimeHostCoordinator.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background connection interrupted; waiting to reconnect"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台连接已中断，正在等待重新连接"
          }
        }
      }
    },
    "connection.invalidPermissionResponse": {
      "extractionState": "manual",
      "comment": "Used in RuntimeHostCoordinator.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background returned an invalid permission response"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台返回了无效的授权回包"
          }
        }
      }
    },
    "connection.open.installed.arcKit.applications": {
      "extractionState": "manual",
      "comment": "Used in RuntimeHostCoordinator.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the installed Arc Kit from Applications, then check again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请从“应用程序”打开已安装的 Arc Kit 后再检查"
          }
        }
      }
    },
    "connection.retryLimit": {
      "extractionState": "manual",
      "comment": "Used in RuntimeHostCoordinator.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeated background connection failures. Automatic reconnection stopped. Check again on Home and view technical details."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台连续连接失败，已停止自动重连；请在首页重新检测并查看技术详情"
          }
        }
      }
    },
    "connection.runtime.session.changed.stopped.check": {
      "extractionState": "manual",
      "comment": "Used in RuntimeHostCoordinator.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The runtime session changed or stopped. Check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行会话已变更或停止，请重新检查"
          }
        }
      }
    },
    "connection.sessionMismatch": {
      "extractionState": "manual",
      "comment": "Used in RuntimeHostCoordinator.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background returned a mismatched runtime session"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台返回了不匹配的运行会话"
          }
        }
      }
    },
    "connection.stopping": {
      "extractionState": "manual",
      "comment": "Used in RuntimeHostCoordinator.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background has not stopped yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台尚未停止"
          }
        }
      }
    },
    "connection.uninstall.preparation.recovery.failed": {
      "extractionState": "manual",
      "comment": "Used in RuntimeHostCoordinator. Arguments: 1 (String), 2 (String).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uninstall preparation failed: %1$@; recovery also failed: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载准备失败：%1$@；恢复也失败：%2$@"
          }
        }
      }
    },
    "connection.unregisterUnavailable": {
      "extractionState": "manual",
      "comment": "Used in RuntimeHostCoordinator.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot uninstall the background service right now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前无法卸载后台服务"
          }
        }
      }
    },
    "host.allow.arcKit.background.item": {
      "extractionState": "manual",
      "comment": "Used in RuntimeHostSystem.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the Arc Kit background item in Login Items settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统登录项中允许 Arc Kit 后台项目"
          }
        }
      }
    },
    "host.background.registration.recovery.incomplete": {
      "extractionState": "manual",
      "comment": "Used in RuntimeHostSystem.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background registration recovery incomplete"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台注册恢复未完成"
          }
        }
      }
    },
    "host.executionDenied": {
      "extractionState": "manual",
      "comment": "Used in RuntimeHostSystem.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background execution is not allowed by macOS yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台尚未获得系统许可"
          }
        }
      }
    },
    "host.installed.arcKit.manage": {
      "extractionState": "manual",
      "comment": "Used in RuntimeHostSystem.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the installed Arc Kit can manage the background service"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台只能由已安装的 Arc Kit 管理"
          }
        }
      }
    },
    "host.launch.login.recovery.incomplete": {
      "extractionState": "manual",
      "comment": "Used in RuntimeHostSystem.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch at login recovery incomplete"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录启动恢复未完成"
          }
        }
      }
    },
    "host.old.background.components.remain.upgrade.using": {
      "extractionState": "manual",
      "comment": "Used in RuntimeHostSystem. Arguments: 1 (String).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Old background components remain. Upgrade using the new installation process: %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧后台尚未清理，请通过新版安装流程升级：%1$@"
          }
        }
      }
    },
    "permissions": {
      "extractionState": "manual",
      "comment": "Used in ApplicationPermissions.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已开启"
          }
        }
      }
    },
    "permissions.allow.arcKit.background.item": {
      "extractionState": "manual",
      "comment": "Used in ApplicationPermissions.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the Arc Kit background item in Login Items settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统登录项中允许 Arc Kit 后台项目"
          }
        }
      }
    },
    "permissions.allow.arcKit.host.system": {
      "extractionState": "manual",
      "comment": "Used in ApplicationPermissions.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Arc Kit Runtime Host in System Settings. The request will not be repeated while waiting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中允许 Arc Kit Runtime Host；本次等待不重复申请"
          }
        }
      }
    },
    "permissions.allow.inputMonitoring.arcKit": {
      "extractionState": "manual",
      "comment": "Used in ApplicationPermissions.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Input Monitoring for Arc Kit to identify the target window before a menu bar click"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请允许 Arc Kit 输入监听，以锁定点击菜单栏前的目标窗口"
          }
        }
      }
    },
    "permissions.allowed": {
      "extractionState": "manual",
      "comment": "Used in ApplicationPermissions.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已允许"
          }
        }
      }
    },
    "permissions.allows.arcKit.provide.finder.menus": {
      "extractionState": "manual",
      "comment": "Used in ApplicationPermissions.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allows Arc Kit to provide Finder menus. The switch alone does not confirm a working menu connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Arc Kit 提供 Finder 菜单；开关不代表菜单链路正常"
          }
        }
      }
    },
    "permissions.arcKit.host.see.feature.status": {
      "extractionState": "manual",
      "comment": "Used in ApplicationPermissions.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arc Kit Runtime Host; see Feature Status for actual availability"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arc Kit Runtime Host；实际功能可用性见功能状态"
          }
        }
      }
    },
    "permissions.backgroundDenied": {
      "extractionState": "manual",
      "comment": "Used in ApplicationPermissions.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background execution not allowed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台未获准运行"
          }
        }
      }
    },
    "permissions.check.again.restore.background.registration": {
      "extractionState": "manual",
      "comment": "Used in ApplicationPermissions.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check again to restore background registration. This does not mean privacy permission was denied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新检测以恢复后台注册；这不代表隐私权限被拒绝"
          }
        }
      }
    },
    "permissions.component.missing": {
      "extractionState": "manual",
      "comment": "Used in ApplicationPermissions.",
      "localizations": {
