    },
    "permissions.finder.off.system.extension.switch": {
      "extractionState": "manual",
      "comment": "Used in ApplicationPermissions.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder is off. The system extension switch is preserved separately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 功能已关闭，系统扩展开关独立保留"
