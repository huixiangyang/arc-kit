    "permissions.grant.access.arcKit.reads.mouse": {
      "extractionState": "manual",
      "comment": "Used in ApplicationPermissions.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant access to Arc Kit. Reads mouse clicks only to identify the target window before menu bar actions; does not record keyboard or page content."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权对象：Arc Kit；只读鼠标点击以锁定菜单栏操作前的窗口，不记录键盘或页面内容"
          }
        }
      }
    },
    "permissions.granted": {
