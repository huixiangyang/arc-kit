          "stringUnit": {
            "state": "translated",
            "value": "组件缺失"
          }
        }
      }
    },
    "permissions.debugAccessibilityHint": {
      "extractionState": "manual",
      "comment": "Used in ApplicationPermissions.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug windows do not check or request system permissions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调试窗口不检测或申请系统授权"
          }
        }
      }
    },
    "permissions.debugExtensionHint": {
      "extractionState": "manual",
      "comment": "Used in ApplicationPermissions.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug windows do not check system extensions"
          }
