      }
    },
    "permissions.finder.windows.mouse.all.off": {
      "extractionState": "manual",
      "comment": "Used in ApplicationPermissions.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder, Windows and Mouse are all off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder、窗口和鼠标均已关闭"
