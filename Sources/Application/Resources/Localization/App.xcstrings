    "debug.window.previews.settings.pages.saves": {
      "extractionState": "manual",
      "comment": "Used in SettingsDebugSession.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This window previews settings pages and saves configuration in a separate debug folder. Background and system operations are not connected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前窗口用于调试管理页面，配置保存到独立调试目录，后台与系统操作未接入。"
          }
        }
      }
    },
