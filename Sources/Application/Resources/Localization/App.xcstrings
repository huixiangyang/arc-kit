    "application.wait.current.operation.finish": {
      "extractionState": "manual",
      "comment": "Used in AppController.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the current operation to finish or resolve the save error before quitting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请等待当前操作结束，或处理保存错误后再退出。"
          }
        }
      }
    },
    "application.window.service.ended": {
      "extractionState": "manual",
      "comment": "Used in AppController.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window service has ended"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口服务已结束"
          }
        }
      }
    },
    "application.windows.mouse.finder.all.off": {
      "extractionState": "manual",
      "comment": "Used in AppController.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows, Mouse and Finder are all off; no background connection needed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口、鼠标和 Finder 均已关闭，无需连接后台"
