{
  "sourceLanguage": "en",
  "strings": {
    "application.app.uninstalled.data.preserved": {
      "extractionState": "manual",
      "comment": "Used in AppController.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App uninstalled; data preserved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用已卸载，数据仍保留"
          }
        }
      }
    },
    "application.background.permission": {
      "extractionState": "manual",
      "comment": "Used in AppController.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background Permission"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台许可"
          }
        }
      }
    },
    "application.description": {
      "extractionState": "manual",
      "comment": "Used in AppController.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS Productivity Toolbox\nSettings are saved locally. External state, such as screenshot location, is always determined by macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 效率工具箱\n设置保存在本机；系统截图位置等外部状态始终以 macOS 为准。"
          }
        }
      }
    },
    "application.desktop.using.arcKit.assets": {
      "extractionState": "manual",
      "comment": "Used in AppController.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The desktop is using Arc Kit assets"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面正在使用 Arc Kit 素材"
          }
        }
      }
    },
    "application.finder.extension.switch": {
      "extractionState": "manual",
      "comment": "Used in AppController.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder extension switch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 扩展开关"
          }
        }
      }
    },
    "application.finder.settings.notReady": {
      "extractionState": "manual",
      "comment": "Used in AppController.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder settings are not ready"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 设置尚未就绪"
          }
        }
      }
    },
    "application.finderConnectionHint": {
      "extractionState": "manual",
      "comment": "Used in AppController.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nCheck the Finder menu connection: Home → Diagnostics"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\nFinder 菜单链路检查：首页 → 诊断"
          }
        }
      }
    },
    "application.hostRestoreFailed": {
      "extractionState": "manual",
      "comment": "Used in AppController.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not restore background service"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台服务恢复失败"
          }
        }
      }
    },
    "application.menuBar.inputMonitoring": {
      "extractionState": "manual",
      "comment": "Used in AppController.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu bar input monitoring"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏输入监听"
          }
        }
      }
    },
    "application.quitIncomplete": {
      "extractionState": "manual",
      "comment": "Used in AppController.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not fully quit Arc Kit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完整退出 Arc Kit"
          }
        }
      }
    },
    "application.restore.settings.access.repairing.finder": {
      "extractionState": "manual",
      "comment": "Used in AppController.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore settings access before repairing Finder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先恢复设置读取，再执行 Finder 修复。"
          }
        }
      }
    },
    "application.switch.system.wallpaper.deleting": {
      "extractionState": "manual",
      "comment": "Used in AppController.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to a system wallpaper before deleting data, or uninstall while keeping data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先切换系统壁纸，再删除数据。也可以选择保留数据卸载。"
          }
        }
      }
    },
    "application.toggle.finder.context.menu": {
      "extractionState": "manual",
      "comment": "Used in AppController.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggle Finder context menu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换 Finder 右键菜单"
          }
        }
      }
    },
    "application.toggle.mouse.enhancement": {
      "extractionState": "manual",
      "comment": "Used in AppController.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggle mouse enhancement"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换鼠标增强"
          }
        }
      }
    },
    "application.toggle.window.management": {
      "extractionState": "manual",
      "comment": "Used in AppController.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggle window management"
