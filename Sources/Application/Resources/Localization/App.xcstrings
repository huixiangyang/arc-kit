    "application.unsavedSettings": {
      "extractionState": "manual",
      "comment": "Used in AppController.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings have not been saved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置尚未保存"
          }
        }
      }
