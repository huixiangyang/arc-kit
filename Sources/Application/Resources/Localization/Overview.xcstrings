{
  "sourceLanguage": "en",
  "strings": {
    "action.re.registers.arcKit.extension": {
      "extractionState": "manual",
      "comment": "Used in FeatureHealthActionButton.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-registers the Arc Kit extension and restarts Finder. Active Finder operations may be interrupted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会重新注册 Arc Kit 扩展并重启 Finder。正在进行的 Finder 操作可能中断。"
          }
        }
      }
    },
    "action.repair.finder.extension.registration": {
      "extractionState": "manual",
      "comment": "Used in FeatureHealthActionButton.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repair Finder extension registration?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修复 Finder 扩展注册？"
          }
        }
      }
    },
    "action.repair.restart.finder": {
      "extractionState": "manual",
      "comment": "Used in FeatureHealthActionButton.",
      "localizations": {
