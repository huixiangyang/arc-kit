    "download.asset.empty.exceeds.mb": {
      "extractionState": "manual",
      "comment": "Used in WallpaperMediaDownload. Arguments: 1 (String).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The asset is empty or exceeds %1$@ MB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "素材为空或超过 %1$@ MB。"
