    "loop.adjusting.click.preview.loop.check": {
      "extractionState": "manual",
      "comment": "Used in WallpaperLoopEditor.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After adjusting, click Preview Loop to check the transition. Exports a silent MP4 and preserves the original. Adjust the segment manually to minimize jumps at the loop boundary."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整后点“预览循环”检查衔接。导出静音 MP4，保留原视频；画面首尾的跳变需自行选择片段调整。"
          }
        }
      }
    },
