      "extractionState": "manual",
      "comment": "Used in WallpaperMediaDownload. Arguments: 1 (String).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download exceeds the %1$@ MB limit. Choose a smaller asset."
