{
  "sourceLanguage": "en",
  "strings": {
    "title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板"
          }
        }
      },
      "comment": "Clipboard history, privacy, file output and iCloud sync."
    },
    "invalidSettings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clipboard settings are invalid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板配置无效，请检查快捷键、保留期限和应用标识。"
          }
        }
      },
      "comment": "Clipboard history, privacy, file output and iCloud sync."
    },
    "invalidContent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This content cannot be saved. Text supports up to 256 KiB; PNG images up to 10 MiB and 40 million pixels."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存此内容。文本上限 256 KiB，PNG 图片上限 10 MiB、4000 万像素。"
          }
        }
      },
      "comment": "Clipboard history, privacy, file output and iCloud sync."
    },
    "unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is not configured in this build. Local clipboard history is available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本未配置 iCloud，本地剪贴板历史可正常使用。"
          }
        }
      },
      "comment": "Clipboard history, privacy, file output and iCloud sync."
    },
    "accountChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iCloud account changed. Connect again to resume syncing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 账户已更换，请重新连接后继续同步。"
          }
        }
      },
      "comment": "Clipboard history, privacy, file output and iCloud sync."
    },
    "signedOut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud in System Settings, then connect again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在系统设置登录 iCloud，再重新连接。"
          }
        }
      },
      "comment": "Clipboard history, privacy, file output and iCloud sync."
    },
    "invalidCloudRecord": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some iCloud records could not be processed. Pending changes have been kept for retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分 iCloud 记录未能处理，待同步变更已保留，请重试。"
          }
        }
      },
      "comment": "Clipboard history, privacy, file output and iCloud sync."
    },
    "noFinderWindow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a local folder in Finder and allow Arc Kit to control Finder, or choose a folder with Save to folder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 Finder 打开一个本地文件夹，并允许 Arc Kit 控制 Finder；也可使用“选择文件夹保存”。"
          }
        }
      },
      "comment": "Clipboard history, privacy, file output and iCloud sync."
    },
    "pasteTargetLost": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original app is no longer available. Copy this item and paste it manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原应用已不可用，请复制此条内容后手动粘贴。"
          }
        }
      },
      "comment": "Clipboard history, privacy, file output and iCloud sync."
    },
    "pastePermission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Arc Kit in Accessibility to paste into another app. Copy remains available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向其他应用粘贴需要为 Arc Kit 授予辅助功能权限；仍可使用“复制”。"
          }
        }
      },
      "comment": "Clipboard history, privacy, file output and iCloud sync."
    },
    "busy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A data operation is in progress. Try again when it finishes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在处理数据，请完成后重试。"
          }
        }
      },
      "comment": "Clipboard history, privacy, file output and iCloud sync."
    },
    "syncOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sync paused · local history"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同步已暂停 · 本地历史"
