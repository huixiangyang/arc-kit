{
  "sourceLanguage": "en",
  "strings": {
    "page.title": {
      "extractionState": "manual",
      "comment": "Agent session backup, browsing and recovery.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent Sessions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 会话"
          }
        }
      }
    },
    "page.description": {
      "extractionState": "manual",
      "comment": "Agent session backup, browsing and recovery.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protect, browse and restore local coding sessions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保护、浏览和恢复本机编程会话"
          }
        }
      }
    },
    "error.settings": {
      "extractionState": "manual",
      "comment": "Agent session backup, browsing and recovery.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid session backup settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话备份设置无效"
          }
        }
      }
    },
    "error.archive": {
      "extractionState": "manual",
      "comment": "Agent session backup, browsing and recovery.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup is damaged, incomplete or unsupported. No data was replaced."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份已损坏、缺失或格式不受支持，未替换现有数据。"
          }
        }
      }
    },
    "error.format": {
      "extractionState": "manual",
      "comment": "Agent session backup, browsing and recovery.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Codex data format is not supported. Update the adapter before restoring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Codex 数据格式尚未支持，请更新适配器后恢复。"
          }
        }
      }
    },
    "error.changed": {
      "extractionState": "manual",
      "comment": "Agent session backup, browsing and recovery.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a partial snapshot. Wait for another backup, or explicitly allow a partial restore."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是一份过程快照。请等待下一次备份，或明确选择恢复部分数据。"
          }
        }
      }
    },
    "error.capacity": {
      "extractionState": "manual",
      "comment": "Agent session backup, browsing and recovery.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup capacity or package size limit has been reached. Increase capacity or export a smaller selection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达到备份容量或单包大小限制。请提高容量或分批导出。"
          }
        }
      }
    },
    "error.password": {
      "extractionState": "manual",
      "comment": "Agent session backup, browsing and recovery.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorrect password or damaged encrypted archive."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "口令错误或加密备份已损坏。"
          }
        }
      }
    },
    "error.passwordShort": {
      "extractionState": "manual",
      "comment": "Agent session backup, browsing and recovery.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a password of at least 12 characters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用至少 12 个字符的口令。"
          }
        }
      }
    },
    "error.busyTarget": {
      "extractionState": "manual",
      "comment": "Agent session backup, browsing and recovery.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex is using the destination. Quit every client using this data directory before restoring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 正在使用目标目录。请退出使用此目录的全部客户端后恢复。"
          }
        }
      }
    },
    "error.native": {
      "extractionState": "manual",
      "comment": "Agent session backup, browsing and recovery.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native restore requires the validated Codex CLI 0.163.0. Choose that executable; browsing and backups remain available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生恢复需要已验证的 Codex CLI 0.163.0。请选择对应可执行文件；浏览和备份不受影响。"
          }
        }
      }
    },
    "error.conflict": {
      "extractionState": "manual",
      "comment": "Agent session backup, browsing and recovery.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is nothing to restore with the current conflict policy. Existing sessions were preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按当前冲突处理规则，没有需要恢复的会话，现有会话已保留。"
          }
        }
      }
    },
    "error.interrupted": {
      "extractionState": "manual",
      "comment": "Agent session backup, browsing and recovery.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An interrupted restore must be rolled back before starting another."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存在中断的恢复，请先回退再开始新的恢复。"
          }
        }
      }
    },
    "error.related": {
      "extractionState": "manual",
      "comment": "Agent session backup, browsing and recovery.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A related parent or child session is missing from this snapshot. Back up the complete session family first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此快照缺少关联的父会话或子会话，请先备份完整会话组。"
          }
        }
      }
    },
    "error.duplicate": {
      "extractionState": "manual",
      "comment": "Agent session backup, browsing and recovery.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicate session ID in this source: %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此来源存在重复会话 ID：%1$@"
          }
        }
      }
    },
    "error.recoveryPath": {
      "extractionState": "manual",
      "comment": "Agent session backup, browsing and recovery.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A restore needs recovery. Keep Codex closed and roll back this journal: %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次恢复需要回退。请保持 Codex 关闭，并回退此记录：%1$@"
          }
        }
      }
    },
    "error.source": {
      "extractionState": "manual",
      "comment": "Agent session backup, browsing and recovery.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an existing local directory without symbolic links."
