    "retention.detail": {
      "extractionState": "manual",
      "comment": "Agent session backup, browsing and recovery.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always keep the latest version, the last complete version and pinned versions. Removing a source keeps its backups. External attachments are read only from directories you authorize."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终保留最新版本、最后一份完整版本和固定版本。移除来源不会删除备份；外部附件只从明确授权的目录读取。"
          }
        }
      }
    },
