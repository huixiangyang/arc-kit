    "auto.detail": {
      "extractionState": "manual",
      "comment": "Agent session backup, browsing and recovery.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs while Arc Kit is open. Changes are grouped, with a check every 5 minutes. Quitting Arc Kit stops protection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arc Kit 运行时合并处理文件变化，每 5 分钟补扫一次；退出 Arc Kit 后停止保护。"
          }
        }
      }
    },
