      "extractionState": "manual",
      "comment": "Used in WallpaperDisplayViews.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each display can have a different wallpaper. Click the arrangement or Change to configure one display."
