    "display.keeps.configuration.restore.video.wallpaper": {
      "extractionState": "manual",
      "comment": "Used in WallpaperDisplayViews.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the configuration to restore video wallpaper when reconnected. Removing it does not delete library assets."
