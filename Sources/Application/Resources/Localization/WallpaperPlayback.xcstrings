    "display.display.automatic.rotation.enabled.applying": {
      "extractionState": "manual",
      "comment": "Used in WallpaperDisplayViews.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This display has automatic rotation enabled. Applying manually does not turn rotation off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此屏幕正在自动轮换，手动应用不会关闭轮换。"
