    "playback.supports.mp4.mov.m4v.silent": {
      "extractionState": "manual",
      "comment": "Used in WallpaperPlaybackView.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supports MP4, MOV and M4V with silent looping. Pauses during sleep or an inactive user session. Stopping reveals the system wallpaper; quitting closes the video."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 MP4、MOV、M4V，静音循环播放；休眠或用户会话停用时暂停。停止后显露系统原有壁纸，退出后视频关闭。"
          }
        }
      }
    },
