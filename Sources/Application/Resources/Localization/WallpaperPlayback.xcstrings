    "playback.rotation.affects.selected.scope.all": {
      "extractionState": "manual",
      "comment": "Used in WallpaperPlaybackView.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotation affects only the selected scope. All displays switch to the same wallpaper together. Manually choosing displays does not change rotation scope. Rotation continues when the window closes and stops when Arc Kit quits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轮换只影响所选范围；全部屏幕会同步切换同一张壁纸。手动选屏不改变轮换范围。关闭管理窗口继续轮换，退出 Arc Kit 后停止。"
          }
        }
      }
    },
