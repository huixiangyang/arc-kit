{
  "sourceLanguage": "en",
  "strings": {
    "apply.disconnectedDuringWrite": {
      "extractionState": "manual",
      "comment": "Used in WallpaperImageTransaction.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display disconnected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕已断开"
          }
        }
      }
    },
    "apply.display.disconnected": {
      "extractionState": "manual",
      "comment": "Used in WallpaperImageTransaction. Arguments: 1 (String).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (display disconnected)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（屏幕已断开）"
          }
        }
      }
    },
    "apply.originalUnavailable": {
      "extractionState": "manual",
      "comment": "Used in WallpaperImageTransaction. Arguments: 1 (String).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (original wallpaper missing or unreadable; restoration not attempted)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（原壁纸文件已不存在或不可读，未尝试写回）"
          }
        }
      }
    },
    "apply.restoration.request.failed": {
      "extractionState": "manual",
      "comment": "Used in WallpaperImageTransaction. Arguments: 1 (String), 2 (String).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (restoration request failed: %2$@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（恢复请求失败：%2$@）"
          }
        }
      }
    },
    "apply.restoration.requested.awaiting.system.confirmation": {
      "extractionState": "manual",
      "comment": "Used in WallpaperImageTransaction.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoration requested; awaiting system confirmation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已请求恢复，系统尚未确认"
          }
        }
      }
    },
    "apply.restoreUnconfirmed": {
      "extractionState": "manual",
      "comment": "Used in WallpaperImageTransaction. Arguments: 1 (String).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original wallpaper restoration unconfirmed: %1$@. Check macOS wallpaper settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原壁纸恢复未完成确认：%1$@。请检查系统壁纸设置。"
          }
        }
      }
    },
    "apply.succeeded": {
      "extractionState": "manual",
      "comment": "Used in WallpaperModel. Arguments: 1 (String), 2 (String), 3 (String).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set “%1$@” as the %3$@ for %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将“%1$@”设为 %2$@ 的%3$@。"
          }
        }
      }
    },
    "apply.systemUnconfirmed": {
      "extractionState": "manual",
      "comment": "Used in WallpaperModel. Arguments: 1 (String).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS accepted the wallpaper setting. Still unconfirmed: %1$@. Configuration saved; refresh Displays & Playback to check."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统已接受壁纸设置；仍待确认：%1$@。已保存配置，请在“屏幕与播放”刷新检查。"
          }
        }
      }
    },
    "apply.targetsDisconnected": {
      "extractionState": "manual",
      "comment": "Used in WallpaperImageTransaction. Arguments: 1 (String).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target displays disconnected: %1$@. No other displays were used."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标屏幕已断开：%1$@。未改为其他屏幕。"
          }
        }
      }
    },
    "apply.unavailable.set.wallpaper": {
      "extractionState": "manual",
      "comment": "Used in WallpaperImageTransaction. Arguments: 1 (String), 2 (String).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not set wallpaper for %1$@: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的壁纸写入失败：%2$@"
          }
        }
      }
    },
    "desktop.debugScope": {
      "extractionState": "manual",
      "comment": "Used in WallpaperDesktop.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug windows do not change the desktop. Apply wallpapers in the installed app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调试窗口不修改桌面，请在安装版中应用壁纸。"
          }
        }
      }
    },
    "desktop.playbackFailed": {
