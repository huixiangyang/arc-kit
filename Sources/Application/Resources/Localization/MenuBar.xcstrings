      "extractionState": "manual",
      "comment": "Menu bar shelf, session-bound action, or global shortcut.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search observed items across all sections, including deep storage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索所有分区中已发现的图标，包含深度收纳。"
          }
        }
      }
    },
    "shelf.search": {
      "extractionState": "manual",
      "comment": "Menu bar shelf, session-bound action, or global shortcut.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find a menu bar item…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索菜单栏图标…"
          }
        }
      }
