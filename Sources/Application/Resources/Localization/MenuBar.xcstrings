        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取菜单栏图标…"
          }
        }
      }
    },
    "shelf.empty": {
      "extractionState": "manual",
      "comment": "Menu bar shelf, session-bound action, or global shortcut.",
      "localizations": {
