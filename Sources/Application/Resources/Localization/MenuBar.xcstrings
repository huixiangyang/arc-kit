    "scope.openCollected": {
      "extractionState": "manual",
      "comment": "Verified menu bar section scope; never falls back from collected items to all items.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open collected items"
          }
        },
        "zh-Hans": {
