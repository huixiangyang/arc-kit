    "shelf.hint": {
      "extractionState": "manual",
      "comment": "Menu bar shelf, session-bound action, or global shortcut.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "↑ ↓ select · Return activates · Esc closes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "↑ ↓ 选择 · 回车取用 · Esc 关闭"
          }
        }
      }
    },
    "shelf.partial": {
      "extractionState": "manual",
      "comment": "Menu bar shelf, session-bound action, or global shortcut.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some applications did not respond. This list may be incomplete."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分应用未响应，当前清单可能不完整。"
          }
        }
      }
    },
    "hotKey.duplicate": {
      "extractionState": "manual",
      "comment": "Menu bar shelf, session-bound action, or global shortcut.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each menu bar action needs a different shortcut."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏各操作不能使用相同的快捷键。"
          }
