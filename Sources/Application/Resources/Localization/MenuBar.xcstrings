    "hotKey.failure": {
      "extractionState": "manual",
      "comment": "Menu bar shelf, session-bound action, or global shortcut.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not register “%1$@” (OSStatus %2$@). Choose another shortcut or retry after releasing the conflict."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”快捷键注册失败（OSStatus %2$@）。请更换组合，或解除冲突后重试。"
          }
        }
      }
    },
    "hotKey.retry": {
      "extractionState": "manual",
      "comment": "Menu bar shelf, session-bound action, or global shortcut.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry registration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试注册"
          }
        }
      }
    },
    "hotKey.registered": {
      "extractionState": "manual",
