    "style.splitDetail": {
      "extractionState": "manual",
      "comment": "Menu bar development inspection and appearance preview.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate commands from status. Leave space between."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左侧是操作，右侧是状态，中间留白。"
          }
        }
      }
    },
    "probe.usage": {
      "extractionState": "manual",
      "comment": "Menu bar development inspection and appearance preview.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage: ArcKitApp --menu-bar-probe <new-directory> | --menu-bar-render <new-directory> | --ui-debug --menu-bar-settings | --menu-bar-native-check <new-directory> | --menu-bar-width-check <new-directory>"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用法：ArcKitApp --menu-bar-probe <新目录> | --menu-bar-render <新目录> | --ui-debug --menu-bar-settings | --menu-bar-native-check <新目录> | --menu-bar-width-check <新目录>"
          }
        }
      }
    },
    "probe.failure": {
      "extractionState": "manual",
      "comment": "Menu bar development inspection and appearance preview.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu bar inspection failed: %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏探测失败：%1$@"
          }
        }
      }
    },
    "inventory.issues": {
      "extractionState": "manual",
      "comment": "The observation can be incomplete. Argument: issue count.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ inspection issues; unresponsive processes may be absent from this list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 条探测问题；未响应进程的图标可能未包含在此清单中。"
          }
        }
      }
    },
