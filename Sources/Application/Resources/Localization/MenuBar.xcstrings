    "settings.enable": {
      "extractionState": "manual",
      "comment": "Menu bar settings, native partition control, and status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable menu bar organization"
          }
        },
