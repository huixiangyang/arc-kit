            "state": "translated",
            "value": "其他显示器"
          }
        }
      }
    },
    "scope.countUnknown": {
      "extractionState": "manual",
      "comment": "Accessible label for an unavailable item count, distinct from zero matches.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Count unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数量未确认"
          }
        }
      }
    },
    "runtime.layoutUnconfirmed": {
      "extractionState": "manual",
      "comment": "Native menu-bar layout did not confirm the requested section state.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS did not confirm the collected layout. The change was reverted. Use Show All to recover."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 未能回读一致的收纳布局，本次变更已撤回。可使用“显示全部”恢复。"
          }
        }
      }
    },
    "overflow.title": {
      "extractionState": "manual",
      "comment": "Native system overflow on macOS 27.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System overflow"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统溢出区"
          }
        }
      }
    },
    "overflow.description": {
      "extractionState": "manual",
      "comment": "Native system overflow on macOS 27.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On macOS 27, collect icons in the system overflow menu. Collapse moves icons to the left of the divider into overflow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 27 使用系统溢出菜单收纳图标。展开时保留分隔线，收起时将左侧图标移入系统溢出区。"
          }
        }
      }
    },
    "overflow.zoneDetail": {
      "extractionState": "manual",
      "comment": "Native system overflow on macOS 27.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open collected icons from system overflow"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收起后从系统溢出入口取用"
          }
        }
      }
    },
    "overflow.arrange": {
      "extractionState": "manual",
      "comment": "Native system overflow on macOS 27.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold ⌘ and drag icons to the left of the horizontal-arrow divider. Keep frequently used icons to the right of the toggle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘，把要收纳的图标拖到双向箭头分隔线左侧；常用图标留在展开控件右侧。"
          }
        }
      }
    },
    "overflow.sectionsUnavailable": {
      "extractionState": "manual",
      "comment": "Native system overflow on macOS 27.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deep storage and collected-only search are unavailable on this system. Use system overflow or search all icons."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此系统暂不支持深度收纳和普通区筛选。可使用系统溢出菜单，或搜索全部图标。"
          }
        }
      }
    },
    "runtime.environmentSettling": {
      "extractionState": "manual",
      "comment": "Recovery is waiting for stable display geometry and owned spacer widths; it does not confirm third-party visibility.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updating the menu bar layout. Keeping all items revealed while it settles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏布局更新中，暂时保持显示全部。"
          }
        }
      }
    },
    "runtime.environmentSleeping": {
      "extractionState": "manual",
      "comment": "State while the system is sleeping; layout events cannot resume collection.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collection spacers are released. Controls resume after the Mac wakes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已释放收纳占位，唤醒后恢复操作。"
          }
        }
      }
    },
    "runtime.recoveryUnconfirmed": {
      "extractionState": "manual",
      "comment": "Bounded recovery confirmation failed; recovery remains available without requiring a geometry snapshot.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The menu bar layout is still changing. Collection spacers remain released. Choose Show All to check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏布局尚未稳定，收纳占位已保持释放。点击“显示全部”可重新检查。"
          }
        }
      }
    },
    "overflow.displayChanged": {
      "extractionState": "manual",
      "comment": "Native system overflow on macOS 27.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This display layout needs more spacers. Show All, then turn menu bar management off and on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前显示器布局需要更多占位。请先显示全部，再关闭并重新开启菜单栏收纳。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
