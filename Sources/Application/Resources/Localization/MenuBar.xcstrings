    "action.showAll": {
      "extractionState": "manual",
      "comment": "Menu bar settings, native partition control, and status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show all"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示全部"
          }
        }
      }
    },
    "action.showAllDetail": {
      "extractionState": "manual",
      "comment": "Menu bar settings, native partition control, and status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expand both Arc Kit sections without changing app settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "展开 Arc Kit 两个收纳区，不更改其他应用设置。"
          }
        }
      }
    },
    "runtime.invalidOrder": {
      "extractionState": "manual",
      "comment": "A non-interactive thin vertical divider marks the boundary; the fixed chevron performs hide/show.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu bar arrangement anchors are invalid. Show all icons, then reload the arrangement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏排列锚点无效。请显示全部，再重新读取编排。"
          }
        }
      }
    },
    "runtime.unavailable": {
      "extractionState": "manual",
      "comment": "Menu bar settings, native partition control, and status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu bar controls or display geometry are unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏控件或显示器几何当前不可用。"
          }
        }
      }
    },
    "action.showAllShort": {
      "extractionState": "manual",
      "comment": "Compact action in the menu bar settings or the partition control menu.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show all"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示全部"
          }
        }
      }
    },
    "access.stale": {
      "extractionState": "manual",
      "comment": "Menu bar shelf, session-bound action, or global shortcut.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This observation has expired. Refresh the shelf before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次图标观察已失效，请刷新收纳栏后再操作。"
          }
        }
      }
    },
    "access.processChanged": {
      "extractionState": "manual",
      "comment": "Menu bar shelf, session-bound action, or global shortcut.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The application has restarted or exited. Refresh the shelf."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用已重启或退出，请刷新收纳栏。"
          }
        }
      }
    },
    "access.displayChanged": {
      "extractionState": "manual",
      "comment": "Menu bar shelf, session-bound action, or global shortcut.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display geometry changed. Reopen the shelf on the intended display."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示器布局已变化，请在目标屏幕重新打开收纳栏。"
          }
        }
      }
    },
    "access.itemUnavailable": {
      "extractionState": "manual",
      "comment": "Menu bar shelf, session-bound action, or global shortcut.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original menu bar item is no longer available. Refresh the shelf."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原菜单栏图标对象已失效，请刷新后再取用。"
          }
        }
      }
    },
    "access.unsupported": {
      "extractionState": "manual",
      "comment": "Menu bar shelf, session-bound action, or global shortcut.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item does not expose a usable menu action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此图标没有提供可用的菜单动作。"
          }
        }
      }
    },
    "access.unconfirmed": {
      "extractionState": "manual",
      "comment": "Menu bar shelf, session-bound action, or global shortcut.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system did not confirm the request (AX %1$@). It may have executed; check the menu before refreshing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统未确认请求（AX %1$@），动作可能已执行。请先检查菜单，再决定是否刷新。"
          }
        }
      }
    },
    "access.accepted": {
      "extractionState": "manual",
      "comment": "Menu bar shelf, session-bound action, or global shortcut.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request sent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发送"
          }
        }
      }
    },
    "shelf.open": {
      "extractionState": "manual",
      "comment": "Menu bar shelf, session-bound action, or global shortcut.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search all icons"
