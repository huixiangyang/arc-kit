{
  "sourceLanguage": "en",
  "strings": {
    "inventory.refresh": {
      "extractionState": "manual",
      "comment": "Menu bar development inspection and appearance preview.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新"
          }
        }
      }
    },
    "identity.session": {
      "extractionState": "manual",
      "comment": "Menu bar development inspection and appearance preview.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅本次会话"
          }
        }
      }
    },
    "identity.candidate": {
      "extractionState": "manual",
      "comment": "Menu bar development inspection and appearance preview.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identity candidate"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "身份候选"
          }
        }
      }
    },
    "probe.usage": {
      "extractionState": "manual",
      "comment": "Menu bar development inspection and appearance preview.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage: ArcKitApp --menu-bar-probe <new-directory> | --menu-bar-render <new-directory> | --ui-debug --menu-bar-settings | --menu-bar-native-check <new-directory> | --menu-bar-width-check <new-directory>"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用法：ArcKitApp --menu-bar-probe <新目录> | --menu-bar-render <新目录> | --ui-debug --menu-bar-settings | --menu-bar-native-check <新目录> | --menu-bar-width-check <新目录>"
          }
        }
      }
    },
    "probe.failure": {
      "extractionState": "manual",
      "comment": "Menu bar development inspection and appearance preview.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu bar inspection failed: %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏探测失败：%1$@"
          }
        }
      }
    },
    "page.title": {
      "extractionState": "manual",
      "comment": "Menu bar settings, native partition control, and status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu Bar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏"
          }
        }
      }
    },
    "page.description": {
      "extractionState": "manual",
      "comment": "Menu bar setup, daily use, and recovery. Icons refer to real controls at the top of the screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide less-used menu bar icons and find them when you need them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏不常用的菜单栏图标，需要时展开或搜索。"
          }
        }
      }
    },
    "settings.enable": {
      "extractionState": "manual",
      "comment": "Menu bar settings, native partition control, and status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable collection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用收纳"
          }
        }
      }
    },
    "settings.invalid": {
      "extractionState": "manual",
      "comment": "Menu bar settings, native partition control, and status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid menu bar opacity or corner radius."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏透明度或圆角数值无效。"
          }
        }
      }
    },
    "settings.deepSection": {
      "extractionState": "manual",
      "comment": "Menu bar settings, native partition control, and status.",
