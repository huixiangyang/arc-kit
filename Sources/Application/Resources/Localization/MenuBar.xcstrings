    "arrange.application.scope": {
      "extractionState": "manual",
      "comment": "System menu bar visibility and recovery.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Icons from one app are collected together. Command-drag in the system menu bar changes order only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一应用的图标一起收纳。在系统菜单栏按住 ⌘ 拖动，只调整顺序，不改变收纳归属。"
          }
        }
      }
    },
