    "settings.invalid": {
      "extractionState": "manual",
      "comment": "Menu bar settings, native partition control, and status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid menu bar opacity or corner radius."
          }
        },
        "zh-Hans": {
          "stringUnit": {
