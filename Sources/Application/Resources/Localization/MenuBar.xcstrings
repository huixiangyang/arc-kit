    },
    "settings.deepSection": {
      "extractionState": "manual",
      "comment": "Menu bar settings, native partition control, and status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable the deep-storage section"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用深度收纳区"
          }
        }
      }
    },
    "settings.experimental": {
      "extractionState": "manual",
      "comment": "Menu bar settings, native partition control, and status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental: native partition controls are implemented; real-menu-bar acceptance is pending. Start with Show All and arrange the dividers before collapsing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验性功能：分区控制代码已接入，仍待实机验收。开启后先显示全部，摆好分隔线再收起。"
          }
        }
      }
    },
    "settings.preview": {
      "extractionState": "manual",
      "comment": "Menu bar settings, native partition control, and status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview mode: settings are saved to the isolated debug database; system menu bar controls remain off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调试预览：设置保存到独立调试库，不创建系统菜单栏控件。"
          }
        }
      }
    },
    "settings.mainPermission": {
      "extractionState": "manual",
      "comment": "Menu bar settings, native partition control, and status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading the inventory requires Accessibility access for Arc Kit itself. Runtime Host permission does not cover the main app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取清单需要为 Arc Kit 主应用授予辅助功能权限；Runtime Host 的授权不能替代。"
          }
        }
      }
    },
    "settings.openPermission": {
      "extractionState": "manual",
      "comment": "Menu bar settings, native partition control, and status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Accessibility settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开辅助功能设置"
          }
        }
      }
    },
    "settings.appearancePreviewOnly": {
      "extractionState": "manual",
      "comment": "Menu bar settings, native partition control, and status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This preset is saved and previewed here. Applying it to the system menu bar awaits overlay validation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预设会保存并在这里预览；应用到系统菜单栏仍待叠层验证。"
          }
        }
      }
    },
