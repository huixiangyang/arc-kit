    "organize.title": {
      "extractionState": "manual",
      "comment": "Menu bar settings, native partition control, and status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the essentials in sight."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常用的常驻，其余的收起。"
          }
        }
      }
    },
    "organize.detail": {
      "extractionState": "manual",
      "comment": "Menu bar settings, native partition control, and status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use native dividers to separate everyday tools from background utilities."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用原生分隔线，区分随手使用的工具与后台常驻项。"
          }
        }
      }
    },
    "organize.nativeDrag": {
      "extractionState": "manual",
      "comment": "Menu bar settings, native partition control, and status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command-drag icons: keep essentials right of the collection divider and collected items left of it. Deep-storage items go left of the deep divider. Keep the expand control at the far right."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘ 拖动图标：常驻项放在收纳分隔线右侧，收纳项放在左侧。深度收纳项放在深度分隔线左侧；展开控件始终放在最右侧。"
          }
        }
      }
    },
    "organize.recovery": {
      "extractionState": "manual",
      "comment": "Menu bar settings, native partition control, and status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Option-click the expand control to show everything. Disabling this feature removes its dividers. New applications, display changes and wake also expand all sections."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Option 点击展开控件可显示全部。关闭功能会移除分隔控件；新应用启动、屏幕变化和唤醒时也会先展开全部。"
          }
        }
      }
    },
    "group.visible": {
      "extractionState": "manual",
      "comment": "Menu bar settings, native partition control, and status.",
      "localizations": {
        "en": {
