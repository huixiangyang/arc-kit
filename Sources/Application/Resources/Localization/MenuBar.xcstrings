    "settings.mainPermission": {
      "extractionState": "manual",
      "comment": "Menu bar settings, native partition control, and status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow accessibility to read menu bar icons."
