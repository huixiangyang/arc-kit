    "shelf.preview": {
      "extractionState": "manual",
      "comment": "Marks offscreen shelf fixtures as illustrative data, never a live system inventory.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PREVIEW DATA"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "演示数据"
          }
        }
      }
    },
    "access.rejected": {
      "extractionState": "manual",
      "comment": "Known AX rejection, distinct from timeouts with uncertain side effects. Argument: AX error code.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system rejected the item action (AX %1$@). Check permissions or refresh the items."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统拒绝了图标操作（AX %1$@），请检查权限或刷新图标。"
          }
        }
      }
    },
    "scope.collected": {
      "extractionState": "manual",
      "comment": "Verified menu bar section scope; never falls back from collected items to all items.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收纳区"
          }
        }
      }
    },
