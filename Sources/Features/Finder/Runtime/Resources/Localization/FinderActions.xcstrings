    "admission.action.already.accepted": {
      "extractionState": "manual",
      "comment": "Used in FinderCommandAdmissionStore.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action was already accepted and its result may be unknown. Check your files first; it will not run again automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此动作已经接收，执行结果可能未知；请先核对文件，不会自动重复执行"
          }
        }
      }
    },
    "admission.too.many.finder.operations.retry.later": {
      "extractionState": "manual",
      "comment": "Used in FinderCommandAdmissionStore.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many Finder operations. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 操作过于频繁，请稍后再试"
