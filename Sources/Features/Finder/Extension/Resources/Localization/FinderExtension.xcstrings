    "action.open.arcKit.menuBar": {
      "extractionState": "manual",
      "comment": "Used in FinderActionCoordinator.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Arc Kit from the menu bar or Applications, then run diagnostics or repair in Finder settings.\n\nThe Finder extension does not launch the main app from context menu actions, avoiding unexpected windows or extra permission prompts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请从菜单栏或“应用程序”打开 Arc Kit，进入「右键管理」执行健康检查或一键修复。\n\nFinder 扩展不会从右键动作里启动主 App，以避免误弹主窗口或触发额外隐私授权。"
          }
        }
      }
    },
