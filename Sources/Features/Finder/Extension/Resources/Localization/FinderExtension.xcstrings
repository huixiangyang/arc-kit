    "action.press.command.shift.finder.toggle": {
      "extractionState": "manual",
      "comment": "Used in FinderActionCoordinator.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press ⌘⇧. (Command+Shift+.) in Finder to toggle hidden files.\n\nYou can also control hidden files in Arc Kit's General settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Finder 中按 ⌘⇧. (Command+Shift+.) 可以快速切换隐藏文件显示。\n\n你也可以在 Arc Kit「系统」页面中通过「切换隐藏文件」按钮控制。"
          }
        }
      }
    },
