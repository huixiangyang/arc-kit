    "monitor.expiredRecoveryHint": {
      "extractionState": "manual",
      "comment": "Used in MouseAgentRuntime.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse monitoring expired. Turn mouse enhancement off and on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标监听已失效，请关闭后重新开启鼠标增强"
          }
        }
      }
    },
    "monitor.failedRecoveryHint": {
      "extractionState": "manual",
      "comment": "Used in MouseAgentRuntime.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse monitoring recovery failed. Turn mouse enhancement off and on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标监听恢复失败，请关闭后重新开启鼠标增强"
          }
        }
      }
    },
    "monitor.gesture.execution.expired.retry": {
      "extractionState": "manual",
      "comment": "Used in MouseAgentRuntime.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesture execution expired. Retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手势执行已过期，请重试"
          }
        }
      }
    },
    "monitor.gesture.processing.overloaded.batch.cancelled": {
      "extractionState": "manual",
      "comment": "Used in MouseAgentRuntime.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesture processing overloaded. This batch was cancelled; retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手势处理过载，本批动作已取消，请重试"
          }
        }
      }
    },
    "monitor.macos.disabled.mouse.monitoring.arcKit": {
      "extractionState": "manual",
      "comment": "Used in MouseAgentRuntime.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS disabled mouse monitoring. Arc Kit will try to recover automatically; if this persists, turn mouse enhancement off and on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标监听被系统停用，Arc Kit 会尝试自动恢复；若持续出现，请关闭后重新开启鼠标增强"
          }
        }
      }
    },
    "monitor.macos.disabled.mouse.monitoring.timeout": {
      "extractionState": "manual",
      "comment": "Used in MouseAgentRuntime.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS disabled mouse monitoring after a timeout. It recovered automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标监听曾因处理超时被系统停用，已自动恢复"
          }
        }
      }
    },
    "monitor.mouse.monitor.created.disabled": {
      "extractionState": "manual",
      "comment": "Used in MouseAgentRuntime.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse monitor was created but not enabled. Check background and monitoring status again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标监听创建后未启用；请重新检测后台和监听状态"
          }
        }
      }
    },
    "monitor.readbackFailed": {
      "extractionState": "manual",
      "comment": "Used in MouseAgentRuntime.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse monitor enablement failed readback validation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标监听启用事件未通过状态回读"
          }
        }
      }
    },
    "monitor.recovered": {
      "extractionState": "manual",
      "comment": "Used in MouseAgentRuntime.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS disabled mouse monitoring. It recovered automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
