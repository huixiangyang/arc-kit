          }
        }
      }
    },
    "session.directScrollFallback": {
      "extractionState": "manual",
      "comment": "Used in MouseScrollSession.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smooth refresh driver unavailable. Using direct scrolling."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑刷新器不可用，当前已降级为直接滚动"
          }
        }
      }
    },
    "session.eventCreationFailed": {
      "extractionState": "manual",
      "comment": "Used in MouseScrollSession.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot create a smooth scroll event. This sequence was cancelled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建平滑滚轮事件，本次轨迹已取消"
          }
        }
      }
    },
    "session.scroll.input.lacks.target.process": {
      "extractionState": "manual",
      "comment": "Used in MouseScrollSession.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll input lacks a target process or window. Using synchronous scrolling."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚轮缺少目标进程或窗口标注，已改为同步滚动"
          }
        }
      }
    }
  },
  "version": "1.0"
}
