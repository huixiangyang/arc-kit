    },
    "validation.listed.apps": {
      "extractionState": "manual",
      "comment": "Used in MouseEnhancementSettings.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listed Apps Only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅列表中的应用"
          }
        }
      }
    },
    "validation.mouse.app.profile.bundleIDs": {
      "extractionState": "manual",
      "comment": "Used in MouseEnhancementSettings.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse app profile bundle identifiers must be unique"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标 App Profile bundleIdentifier 不能重复"
          }
        }
      }
    },
    "validation.mouse.app.profile.ids.unique": {
      "extractionState": "manual",
      "comment": "Used in MouseEnhancementSettings.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse app profile IDs must be unique"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标 App Profile id 不能重复"
          }
        }
      }
    },
    "validation.selfProfileRejected": {
      "extractionState": "manual",
      "comment": "Used in MouseEnhancementSettings.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse app profiles cannot include Arc Kit itself"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标 App Profile 不允许包含 Arc Kit 自身"
