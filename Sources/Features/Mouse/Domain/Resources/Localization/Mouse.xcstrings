    "validation.appBundleIDRequired": {
      "extractionState": "manual",
      "comment": "Used in MouseEnhancementSettings.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse app profiles require an explicit bundleIdentifier"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标 App Profile 必须绑定明确 bundleIdentifier"
          }
        }
