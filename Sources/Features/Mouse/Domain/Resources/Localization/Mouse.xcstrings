    "gesture.mouse.gesture.bindings.cover.every.direction": {
      "extractionState": "manual",
      "comment": "Used in MouseGestureEngine.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse gesture bindings must cover every direction exactly once"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标手势绑定必须完整且每个方向只能出现一次"
          }
        }
      }
    },
    "gesture.mouse.gesture.distance.outside.current": {
      "extractionState": "manual",
      "comment": "Used in MouseGestureEngine.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse gesture distance is outside the current schema's range"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标手势触发距离超出当前 schema 允许范围"
