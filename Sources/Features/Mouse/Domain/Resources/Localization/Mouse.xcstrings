{
  "sourceLanguage": "en",
  "strings": {
    "appProfile.uuRemote": {
      "extractionState": "manual",
      "comment": "Name of the editable default UU Remote scrolling rule.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UU Remote"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "UU 远程"
          }
        }
      }
    },
    "appProfile.bundleIDRequired": {
      "extractionState": "manual",
      "comment": "Used in MouseAppScrollProfile.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot add an app profile without an app name and Bundle ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法添加 App Profile：应用名称或 Bundle ID 为空"
          }
        }
      }
    },
    "appProfile.custom.settings": {
      "extractionState": "manual",
      "comment": "Used in MouseAppScrollProfile.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单独设置"
          }
        }
      }
    },
    "appProfile.follow.global": {
      "extractionState": "manual",
      "comment": "Use the default tuning from the scrolling and advanced tabs, even when enhancement is off for apps without a rule.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Default Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用默认参数"
          }
        }
      }
    },
    "appProfile.invalidBundleID": {
      "extractionState": "manual",
      "comment": "Used in MouseAppScrollProfile.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse profile bundleIdentifier cannot be empty or have leading or trailing whitespace"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标 Profile bundleIdentifier 不能为空或包含首尾空白"
          }
        }
      }
    },
    "appProfile.invalidName": {
      "extractionState": "manual",
      "comment": "Used in MouseAppScrollProfile.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse profile name cannot be empty or have leading or trailing whitespace"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标 Profile 名称不能为空或包含首尾空白"
          }
        }
      }
    },
    "appProfile.selfProfileRejected": {
      "extractionState": "manual",
      "comment": "Used in MouseAppScrollProfile.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arc Kit cannot be added to its own mouse enhancement profiles"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不能把 Arc Kit 自己加入鼠标增强 App Profile"
          }
        }
      }
    },
    "appProfile.use.system.scrolling": {
      "extractionState": "manual",
      "comment": "Pass the app scrolling events through unchanged, without Arc Kit smoothing, reversal, acceleration or modifier conversion.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Enhancement"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不启用增强"
          }
        }
      }
    },
