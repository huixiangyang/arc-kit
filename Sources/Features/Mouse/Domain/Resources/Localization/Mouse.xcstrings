    "tuning.duplicateModifier": {
      "extractionState": "manual",
      "comment": "Used in MouseScrollTuning.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse scrolling actions cannot share the same modifier key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标滚动动作不能重复使用同一个修饰键"
