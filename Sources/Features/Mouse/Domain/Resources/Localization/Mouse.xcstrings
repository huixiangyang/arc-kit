    "appProfile.uuRemoteNote": {
      "extractionState": "manual",
      "comment": "Editable note explaining the default UU Remote scrolling rule.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UU Remote already reverses scrolling. Avoid reversing it twice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "UU 远程自带滚动翻转，避免重复翻转。"
          }
        }
      }
    }
