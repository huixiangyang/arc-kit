{
  "sourceLanguage": "en",
  "strings": {
    "appRules.bundleIDRequired": {
      "extractionState": "manual",
      "comment": "Used in WindowApplicationRules.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot add an excluded app without an app name and Bundle ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法添加排除 App：应用名称或 Bundle ID 为空"
          }
        }
      }
    },
    "appRules.emptyBundleID": {
      "extractionState": "manual",
      "comment": "Used in WindowApplicationRules.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluded window app bundleIdentifier cannot be empty or have leading or trailing whitespace"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口排除 App bundleIdentifier 不能为空或包含首尾空白"
          }
        }
      }
    },
    "appRules.emptyName": {
      "extractionState": "manual",
      "comment": "Used in WindowApplicationRules.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluded window app name cannot be empty or have leading or trailing whitespace"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口排除 App 名称不能为空或包含首尾空白"
          }
        }
      }
    },
    "appRules.selfExclusionRejected": {
      "extractionState": "manual",
      "comment": "Used in WindowApplicationRules.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arc Kit cannot be added to its own window exclusion list"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不能把 Arc Kit 自己加入窗口管理排除列表"
          }
        }
      }
    },
