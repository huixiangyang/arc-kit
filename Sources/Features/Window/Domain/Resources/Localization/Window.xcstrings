    "shortcut.window.shortcut.display.value.one": {
      "extractionState": "manual",
      "comment": "Used in WindowHotKey.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window shortcut display value must be one printable key or an explicit special key name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口快捷键显示值必须是单个可显示按键或明确的特殊键名"
          }
        }
      }
    },
    "shortcut.window.shortcut.keycode.outside.supported": {
      "extractionState": "manual",
      "comment": "Used in WindowHotKey.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window shortcut keyCode is outside the supported macOS virtual key range"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口快捷键 keyCode 超出当前支持的 macOS 虚拟键码范围"
          }
        }
      }
    },
    "shortcut.window.shortcut.modifier.contains.unknown.bits": {
      "extractionState": "manual",
      "comment": "Used in WindowHotKey.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window shortcut modifier contains unknown bits"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口快捷键修饰键包含未知位"
          }
        }
      }
    },
    "validation.each.window.action.one": {
      "extractionState": "manual",
      "comment": "Used in WindowManagementSettings.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each window action can have only one shortcut"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个窗口动作只能配置一个快捷键"
          }
        }
      }
    },
    "validation.excluded.window.app.bundleIDs": {
      "extractionState": "manual",
      "comment": "Used in WindowManagementSettings.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluded window app bundle identifiers must be unique"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口排除 App bundleIdentifier 不能重复"
          }
        }
      }
    },
    "validation.excluded.window.app.names.bundleIDs": {
      "extractionState": "manual",
      "comment": "Used in WindowManagementSettings.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluded window app names and bundle identifiers cannot have leading or trailing whitespace"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口排除 App 名称和 bundleIdentifier 不得包含首尾空白"
          }
        }
      }
    },
    "validation.excluded.window.apps.require.nonempty.name": {
      "extractionState": "manual",
      "comment": "Used in WindowManagementSettings.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluded window apps require a nonempty name and bundleIdentifier"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口排除 App 必须包含非空名称和 bundleIdentifier"
          }
        }
      }
    },
    "validation.selfExclusionRejected": {
      "extractionState": "manual",
      "comment": "Used in WindowManagementSettings.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arc Kit cannot be excluded from its own window management"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口排除 App 不允许包含 Arc Kit 自身"
          }
        }
      }
    },
    "validation.window.spacing.outside.current.schema": {
      "extractionState": "manual",
      "comment": "Used in WindowManagementSettings.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window spacing is outside the current schema's range"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口间距超出当前 schema 允许范围"
          }
        }
      }
    }
  },
  "version": "1.0"
}
