          "stringUnit": {
            "state": "translated",
            "value": "全屏"
          }
        }
      }
    },
    "shortcuts.eventHandlerFailed": {
      "extractionState": "manual",
      "comment": "Used in WindowAgentHotKeyRuntime.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not install global shortcut event handler"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全局快捷键事件处理器安装失败"
          }
        }
      }
    },
    "shortcuts.retryingRegistration": {
      "extractionState": "manual",
      "comment": "Used in WindowAgentHotKeyRuntime. Arguments: 1 (String).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Global shortcuts failed to register: %1$@. Retrying automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 个全局快捷键注册失败，正在自动重试"
          }
        }
      }
    },
    "shortcuts.serviceUnavailable": {
      "extractionState": "manual",
      "comment": "Used in WindowAgentHotKeyRuntime.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window shortcut execution service unavailable. Reload settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口快捷键执行服务不可用，请重载设置"
          }
        }
      }
    },
    "shortcuts.unregisteredEvent": {
      "extractionState": "manual",
      "comment": "Used in WindowAgentHotKeyRuntime.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Received an unregistered window shortcut event. Turn window management off and on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收到未注册的窗口快捷键事件，请关闭后重新开启窗口管理"
          }
        }
      }
    },
