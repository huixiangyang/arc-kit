      "extractionState": "manual",
      "comment": "Used in WindowAgentRuntime.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window configuration changed. Action cancelled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口配置已变化，操作已取消"
          }
        }
      }
    },
