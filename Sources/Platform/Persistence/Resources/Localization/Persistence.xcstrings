        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份版本或完整性不匹配"
          }
        }
      }
    },
    "database.configuration.database.notReady": {
      "extractionState": "manual",
      "comment": "Used in ArcKitDatabase.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
