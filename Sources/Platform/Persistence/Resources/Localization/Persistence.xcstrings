{
  "sourceLanguage": "en",
  "strings": {
    "asset.asset.record.contains.invalid.path": {
      "extractionState": "manual",
      "comment": "Used in ArcKitAssetStore.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asset record contains an invalid path"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资源记录包含无效路径"
          }
        }
      }
    },
    "asset.existing.asset.verification.reuse.refused.failed": {
      "extractionState": "manual",
      "comment": "Used in ArcKitAssetStore.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing asset failed verification; reuse refused"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有资源校验失败，拒绝复用"
          }
        }
      }
    },
    "asset.invalid.asset.extension": {
      "extractionState": "manual",
      "comment": "Used in ArcKitAssetStore.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid asset extension"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资源扩展名无效"
          }
        }
      }
    },
    "asset.invalid.asset.size.file.type": {
      "extractionState": "manual",
      "comment": "Used in ArcKitAssetStore.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid asset size or file type"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资源体积或文件类型无效"
          }
        }
      }
    },
    "database.another.app.using.data.folder": {
      "extractionState": "manual",
      "comment": "Used in ArcKitDatabase.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another app is using this data folder. A second configuration writer is not allowed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有应用正在使用该数据目录，拒绝启动第二个配置写入者"
          }
        }
      }
    },
    "database.app.still.using.data": {
      "extractionState": "manual",
      "comment": "Used in ArcKitDatabase.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is still using the data. Quit it first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用仍在使用数据，请先退出"
          }
        }
      }
    },
    "database.app.still.using.database": {
      "extractionState": "manual",
      "comment": "Used in ArcKitDatabase.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is still using the database. Quit before restoring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用仍在使用数据库，请退出后恢复"
          }
        }
      }
    },
    "database.backup.destination.already.exists": {
      "extractionState": "manual",
      "comment": "Used in ArcKitDatabase.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup destination already exists"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份目标已存在"
          }
        }
      }
    },
    "database.backup.integrity.check.failed": {
      "extractionState": "manual",
      "comment": "Used in ArcKitDatabase.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup integrity check failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份完整性校验失败"
          }
        }
      }
    },
    "database.backup.version.integrity.mismatch": {
      "extractionState": "manual",
      "comment": "Used in ArcKitDatabase.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup version or integrity mismatch"
          }
