    "storage.data.path.local": {
      "extractionState": "manual",
      "comment": "Used in ArcKitStoragePaths.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data path must be local and owned by the current user. Cloud drives, network volumes, symlinks and hard links are not allowed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据路径必须由当前用户拥有且位于本地，不能使用云盘、网络卷、符号链接或硬链接。"
          }
        }
      }
    },
